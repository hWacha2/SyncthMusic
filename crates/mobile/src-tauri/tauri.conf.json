{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynctMusic",
  "version": "0.1.0",
  "identifier": "org.syncth.music.mobile",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SynctMusic",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Синхронизация музыки без облака",
    "longDescription": "SynctMusic держит одну и ту же музыкальную библиотеку на телефоне и компьютере: файлы остаются на месте, удаления обратимы.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
